+            if not stat.S_ISREG(entry_stat.st_mode) or entry_stat.st_nlink != 1:
+                raise CandidateIntegrityError(
+                    "candidate pool lock must be regular"
+                )
+            if (entry_stat.st_dev, entry_stat.st_ino) != (
