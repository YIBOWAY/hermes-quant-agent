+            if not stat.S_ISREG(held.st_mode) or held.st_nlink != 1:
+                raise CandidateIntegrityError(
+                    "candidate pool lock must be regular"
+                )
+            yield opened
+            entry_stat = os.stat(
+                ".candidate-pool.lock",
+                dir_fd=opened.fd,
+                follow_symlinks=False,
