+@pytest.mark.parametrize(
+    "layout",
+    [
+        "legacy_eq_canonical",
+        "backup_eq_legacy",
+        "backup_inside_legacy",
+        "legacy_inside_backup",
+        "canonical_inside_legacy",
+        "legacy_inside_canonical",
+        "backup_inside_canonical",
+        "canonical_inside_backup",
